{
  "title": "catalog (contract 1.0.0)",
  "$comment": "Generated from web/src/lib/contracts by `npm run contracts:export`. Do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "isFixture": {
      "type": "boolean"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "REAL",
        "CALIBRATED_SYNTHETIC",
        "SCENARIO",
        "SIMULATED_FEED",
        "DERIVED",
        "PRECOMPUTED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "stores": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "emirate": {
            "type": "string",
            "enum": [
              "Dubai",
              "Sharjah",
              "Abu Dhabi"
            ]
          },
          "lat": {
            "type": "number",
            "minimum": 22,
            "maximum": 27
          },
          "lon": {
            "type": "number",
            "minimum": 51,
            "maximum": 57
          },
          "sizeIndex": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "area",
          "emirate",
          "lat",
          "lon",
          "sizeIndex"
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shelfLifeDays": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "shelfLifeDays"
        ],
        "additionalProperties": false
      }
    },
    "skus": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "kg",
              "each",
              "pack"
            ]
          },
          "kgPerUnit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "shelfLifeDays": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unitCostAED": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "priceAED": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "casePack": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "primarySupplierId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "required": [
          "id",
          "name",
          "categoryId",
          "unit",
          "kgPerUnit",
          "shelfLifeDays",
          "unitCostAED",
          "priceAED",
          "casePack",
          "primarySupplierId"
        ],
        "additionalProperties": false
      }
    },
    "heroSeries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "skuId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "required": [
          "storeId",
          "skuId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "generatedAt",
    "generator",
    "seed",
    "isFixture",
    "provenance",
    "sources",
    "stores",
    "categories",
    "skus",
    "heroSeries"
  ],
  "additionalProperties": false
}
