{
  "title": "live-feed (contract 1.0.0)",
  "$comment": "Generated from web/src/lib/contracts by `npm run contracts:export`. Do not edit by hand.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "isFixture": {
      "type": "boolean"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "REAL",
        "CALIBRATED_SYNTHETIC",
        "SCENARIO",
        "SIMULATED_FEED",
        "DERIVED",
        "PRECOMPUTED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "timezone": {
      "type": "string",
      "const": "Asia/Dubai"
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):00$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):00$"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "storeIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "skuIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "ticks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):00$"
          },
          "storeId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "skuId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "onHand": {
            "type": "number",
            "minimum": 0
          },
          "sales": {
            "type": "number",
            "minimum": 0
          },
          "receipts": {
            "type": "number",
            "minimum": 0
          },
          "waste": {
            "type": "number",
            "minimum": 0
          },
          "coverHours": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "in_stock",
              "at_risk",
              "expiring",
              "stockout"
            ]
          }
        },
        "required": [
          "t",
          "storeId",
          "skuId",
          "onHand",
          "sales",
          "receipts",
          "waste",
          "coverHours",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):00$"
          },
          "storeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "skuId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "stockout_risk",
              "stockout",
              "spike_detected",
              "expiring",
              "po_created",
              "po_received",
              "disruption"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "good",
              "warning",
              "serious",
              "critical"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "poId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "t",
          "storeId",
          "skuId",
          "kind",
          "severity",
          "message",
          "poId"
        ],
        "additionalProperties": false
      }
    },
    "purchaseOrders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "createdAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):00$"
          },
          "supplierId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "storeId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "skuId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "etaAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):00$"
          },
          "approval": {
            "type": "string",
            "enum": [
              "auto",
              "needs_approval",
              "approved",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "createdAt",
          "supplierId",
          "storeId",
          "skuId",
          "qty",
          "etaAt",
          "approval",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "generatedAt",
    "generator",
    "seed",
    "isFixture",
    "provenance",
    "sources",
    "timezone",
    "window",
    "storeIds",
    "skuIds",
    "ticks",
    "events",
    "purchaseOrders"
  ],
  "additionalProperties": false
}
